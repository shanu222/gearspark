# GearSpark environment variables
# ---------------------------------------------------------------
# GearSpark is a fully client-side game. It has NO backend, NO database,
# NO file storage and NO secrets. Nothing here is required to run it.
#
# Vercel (frontend) — optional, used only at build time:
#
# Public URL of the deployed site, without a trailing slash.
# When set, the build adds canonical + Open Graph/Twitter image URLs and a sitemap.xml.
# Example: https://gearspark.vercel.app  or  https://gearspark.freearcadehub.com
SITE_URL=
#
# Railway: not used. No backend service is required.
# Railway PostgreSQL: not used. Progress is saved in each player's browser (localStorage).
# Cloudflare R2: not used. The game has no uploads or user files; all art is drawn in code.
